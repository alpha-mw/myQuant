{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.dataset-manifest.v1",
  "title": "V17DatasetManifestV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finiteScalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "schemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "logical_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "nullable": {"type": "boolean"}
      },
      "required": ["name", "logical_type", "nullable"]
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:/\\.{1,2}(?:/|$)))(?!.*\\/$)[A-Za-z0-9][A-Za-z0-9._/=-]*$"
        },
        "partition_values": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/finiteScalar"}
        },
        "object_path": {
          "type": "string",
          "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.(parquet|blob)$"
        },
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "row_count": {"type": "integer", "minimum": 0},
        "min_key": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/finiteScalar"}
        },
        "max_key": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/finiteScalar"}
        },
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "logical_name",
        "partition_values",
        "object_path",
        "byte_sha256",
        "size_bytes",
        "row_count",
        "min_key",
        "max_key",
        "schema_sha256"
      ]
    }
  },
  "properties": {
    "version": {"const": "myquant.v17.dataset-manifest.v1"},
    "dataset_id": {"$ref": "#/$defs/identifier"},
    "role": {"$ref": "#/$defs/identifier"},
    "format": {"enum": ["PARQUET", "BLOB"]},
    "media_type": {
      "enum": ["application/vnd.apache.parquet", "application/octet-stream"]
    },
    "schema": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/schemaEntry"}
    },
    "primary_key": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "partition_keys": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "sort_keys": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shard"}
    },
    "total_row_count": {"type": "integer", "minimum": 0},
    "total_size_bytes": {"type": "integer", "minimum": 1},
    "content_set_sha256": {"$ref": "#/$defs/sha256"},
    "authority": {"const": false},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "version",
    "dataset_id",
    "role",
    "format",
    "media_type",
    "schema",
    "primary_key",
    "partition_keys",
    "sort_keys",
    "shards",
    "total_row_count",
    "total_size_bytes",
    "content_set_sha256",
    "authority",
    "semantic_sha256"
  ],
  "allOf": [
    {
      "if": {"properties": {"format": {"const": "PARQUET"}}},
      "then": {
        "properties": {
          "media_type": {"const": "application/vnd.apache.parquet"},
          "schema": {"minItems": 1},
          "primary_key": {"minItems": 1},
          "shards": {
            "items": {
              "properties": {
                "object_path": {
                  "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.parquet$"
                },
                "row_count": {"type": "integer", "minimum": 1},
                "min_key": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {"$ref": "#/$defs/finiteScalar"}
                },
                "max_key": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {"$ref": "#/$defs/finiteScalar"}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "media_type": {"const": "application/octet-stream"},
          "schema": {"maxItems": 0},
          "primary_key": {"maxItems": 0},
          "partition_keys": {"maxItems": 0},
          "sort_keys": {"maxItems": 0},
          "total_row_count": {"const": 0},
          "shards": {
            "items": {
              "properties": {
                "object_path": {
                  "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.blob$"
                },
                "partition_values": {"maxProperties": 0},
                "row_count": {"const": 0},
                "min_key": {"const": null},
                "max_key": {"const": null}
              }
            }
          }
        }
      }
    }
  ]
}
