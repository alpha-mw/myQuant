{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.holdings-snapshot.v1",
  "title": "HoldingsSnapshot",
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"const": "myquant.v17.holdings-snapshot.v1"},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "market": {"const": "CN"}, "availability": {"const": "AVAILABLE"},
        "pit_cutoff": {"type": "string", "minLength": 10},
        "as_of": {"type": "string", "format": "date-time"},
        "nav": {"type": "number", "exclusiveMinimum": 0},
        "cash": {"type": "number", "minimum": 0},
        "declared_all_cash": {"type": "boolean"},
        "positions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {"symbol": {"type": "string"}, "market_value": {"type": "number", "exclusiveMinimum": 0}},
            "required": ["symbol", "market_value"]
          }
        },
        "authority": {"const": false}, "semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["version", "snapshot_id", "strategy_id", "market", "availability", "pit_cutoff", "as_of", "nav", "cash", "declared_all_cash", "positions", "authority", "semantic_sha256"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"const": "myquant.v17.holdings-snapshot.v1"},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "market": {"const": "CN"}, "availability": {"const": "UNAVAILABLE"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "authority": {"const": false}, "semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["version", "snapshot_id", "strategy_id", "market", "availability", "reason", "authority", "semantic_sha256"]
    }
  ]
}
