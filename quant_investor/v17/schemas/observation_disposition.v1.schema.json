{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.observation-disposition.v1",
  "title": "V17ObservationDispositionManifestV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "value": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["name", "value"]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"$ref": "#/$defs/identifier"},
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "required": ["role", "byte_sha256", "semantic_sha256"]
    },
    "datasetManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_path": {
          "type": "string",
          "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"
        },
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "myquant.v17.dataset-manifest.v1"}
      },
      "required": [
        "object_path",
        "byte_sha256",
        "size_bytes",
        "semantic_sha256",
        "schema_version"
      ]
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {"$ref": "#/$defs/identifier"},
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/keyComponent"}
            }
          },
          "required": ["domain", "components"]
        },
        "observation_key_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["INVALID", "UNAVAILABLE", "UNREADY"]},
        "effect": {
          "enum": [
            "HARD_STOP_INVALID_EVIDENCE",
            "EXCLUDE_UNAVAILABLE",
            "MARK_STATISTICALLY_UNREADY"
          ]
        },
        "reason_code": {"$ref": "#/$defs/identifier"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      },
      "required": [
        "observation_key",
        "observation_key_sha256",
        "status",
        "effect",
        "reason_code",
        "detail",
        "source_refs"
      ],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "INVALID"}}},
          "then": {"properties": {"effect": {"const": "HARD_STOP_INVALID_EVIDENCE"}}}
        },
        {
          "if": {"properties": {"status": {"const": "UNAVAILABLE"}}},
          "then": {"properties": {"effect": {"const": "EXCLUDE_UNAVAILABLE"}}}
        },
        {
          "if": {"properties": {"status": {"const": "UNREADY"}}},
          "then": {"properties": {"effect": {"const": "MARK_STATISTICALLY_UNREADY"}}}
        }
      ]
    }
  },
  "properties": {
    "version": {"const": "myquant.v17.observation-disposition.v1"},
    "disposition_id": {"$ref": "#/$defs/identifier"},
    "scope_id": {"$ref": "#/$defs/identifier"},
    "stage": {
      "enum": [
        "SOURCE_CAPTURE",
        "PIT_PROJECTION",
        "FUNDAMENTAL_SCORING",
        "FUNDAMENTAL_CALIBRATION",
        "QUANT_CALIBRATION",
        "DEEP_RESEARCH",
        "PORTFOLIO"
      ]
    },
    "market": {"const": "CN"},
    "cutoff": {"type": "string", "format": "date-time"},
    "expected_observation_count": {"type": "integer", "minimum": 0},
    "accepted_observation_count": {"type": "integer", "minimum": 0},
    "disposition_count": {"type": "integer", "minimum": 0},
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "INVALID": {"type": "integer", "minimum": 0},
        "UNAVAILABLE": {"type": "integer", "minimum": 0},
        "UNREADY": {"type": "integer", "minimum": 0}
      },
      "required": ["INVALID", "UNAVAILABLE", "UNREADY"]
    },
    "expected_keys_sha256": {"$ref": "#/$defs/sha256"},
    "accepted_keys_sha256": {"$ref": "#/$defs/sha256"},
    "disposition_keys_sha256": {"$ref": "#/$defs/sha256"},
    "record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "content_set_sha256": {"$ref": "#/$defs/sha256"},
    "disposition_ordering": {"const": "observation_key_sha256-ascending"},
    "dataset_manifest_ref": {"$ref": "#/$defs/datasetManifestRef"},
    "authority": {"const": false},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "version",
    "disposition_id",
    "scope_id",
    "stage",
    "market",
    "cutoff",
    "expected_observation_count",
    "accepted_observation_count",
    "disposition_count",
    "status_counts",
    "expected_keys_sha256",
    "accepted_keys_sha256",
    "disposition_keys_sha256",
    "record_schema_sha256",
    "content_set_sha256",
    "disposition_ordering",
    "dataset_manifest_ref",
    "authority",
    "semantic_sha256"
  ]
}
