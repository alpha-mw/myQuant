{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.pretrade-result.v1",
  "title": "PreTradeResult",
  "type": "object", "additionalProperties": false,
  "properties": {
    "version": {"const": "myquant.v17.pretrade-result.v1"}, "symbol": {"type": "string"}, "side": {"enum": ["BUY", "SELL"]},
    "passed": {"type": "boolean"}, "checks": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "cost": {"type": "object"},
    "proposal_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permission_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_policy_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_policy_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"const": false}, "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["version", "symbol", "side", "passed", "checks", "cost", "proposal_semantic_sha256", "permission_semantic_sha256", "risk_policy_semantic_sha256", "cost_policy_semantic_sha256", "authority", "semantic_sha256"]
}
