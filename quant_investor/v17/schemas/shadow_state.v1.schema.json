{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myquant.local/schemas/v17/shadow_state.v1.schema.json",
  "title": "myQuant v17 shadow CAS ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "strategy_id",
    "market",
    "cutoff",
    "state",
    "sequence",
    "created_at",
    "updated_at",
    "previous_ledger_sha256",
    "input_bindings",
    "artifacts",
    "history",
    "authority",
    "semantic_sha256"
  ],
  "properties": {
    "version": {"const": "myquant.v17.shadow-ledger.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "market": {"const": "CN"},
    "cutoff": {"type": "string", "minLength": 10},
    "state": {
      "enum": [
        "PREPARED",
        "DETERMINISTIC_COMPLETE",
        "DEEP_REQUEST_READY",
        "DEEP_RESPONSE_RECEIVED",
        "PORTFOLIO_COMPLETE",
        "SHADOW_COMPLETE_AWAITING_HUMAN_DECISION",
        "SHADOW_RANK_COMPLETE_NO_PORTFOLIO",
        "SHADOW_PORTFOLIO_INFEASIBLE",
        "HARD_STOP_SNAPSHOT_DRIFT",
        "HARD_STOP_INVALID_EVIDENCE"
      ]
    },
    "sequence": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "minLength": 20},
    "updated_at": {"type": "string", "minLength": 20},
    "previous_ledger_sha256": {
      "anyOf": [
        {"const": "EMPTY"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "input_bindings": {"type": "object"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/artifactBinding"}
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/historyItem"}
    },
    "authority": {"const": false},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "byte_sha256",
        "semantic_sha256",
        "sequence",
        "state"
      ],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "historyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "from_state",
        "to_state",
        "at",
        "expected_ledger_sha256",
        "artifact_roles"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 20},
        "expected_ledger_sha256": {
          "anyOf": [
            {"const": "EMPTY"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "artifact_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
