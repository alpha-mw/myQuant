{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.regime-portfolio-overlay.v1",
  "title": "RegimePortfolioOverlay",
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "properties": {
        "version": {"const": "myquant.v17.regime-portfolio-overlay.v1"},
        "availability": {"const": "AVAILABLE"},
        "gross_cap": {"type": "number", "minimum": 0, "maximum": 1},
        "cash_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_gross": {"type": "number", "minimum": 0, "maximum": 1},
        "components": {"type": "object", "additionalProperties": false, "properties": {"base": {"type": "object"}, "macro": {"type": "object"}, "markov": {"type": "object"}}, "required": ["base", "macro", "markov"]},
        "authority": {"const": false}, "semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["version", "availability", "gross_cap", "cash_floor", "effective_gross", "components", "authority", "semantic_sha256"]
    },
    {
      "type": "object", "additionalProperties": false,
      "properties": {
        "version": {"const": "myquant.v17.regime-portfolio-overlay.v1"},
        "availability": {"const": "UNAVAILABLE"},
        "reason": {"const": "enabled_regime_input_unavailable"},
        "missing_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["macro", "markov"]}},
        "authority": {"const": false}, "semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["version", "availability", "reason", "missing_inputs", "authority", "semantic_sha256"]
    }
  ]
}
