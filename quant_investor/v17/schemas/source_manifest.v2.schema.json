{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.source-manifest.v2",
  "title": "V17SourceManifestV2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jsonObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_path": {
          "type": "string",
          "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"
        },
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"$ref": "#/$defs/identifier"}
      },
      "required": [
        "object_path",
        "byte_sha256",
        "size_bytes",
        "semantic_sha256",
        "schema_version"
      ]
    },
    "availableJsonObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "availability": {"const": "AVAILABLE"},
        "kind": {"const": "OBJECT"},
        "object_ref": {"$ref": "#/$defs/jsonObjectRef"}
      },
      "required": ["source_id", "role", "availability", "kind", "object_ref"]
    },
    "availableDataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "availability": {"const": "AVAILABLE"},
        "kind": {"const": "DATASET"},
        "dataset_manifest_ref": {
          "allOf": [
            {"$ref": "#/$defs/jsonObjectRef"},
            {
              "type": "object",
              "properties": {
                "schema_version": {"const": "myquant.v17.dataset-manifest.v1"}
              }
            }
          ]
        }
      },
      "required": [
        "source_id",
        "role",
        "availability",
        "kind",
        "dataset_manifest_ref"
      ]
    },
    "unavailableSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "availability": {"const": "UNAVAILABLE"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["source_id", "role", "availability", "reason"]
    }
  },
  "properties": {
    "version": {"const": "myquant.v17.source-manifest.v2"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "market": {"const": "CN"},
    "cutoff": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "object_path_scheme": {"const": "sha256-prefix-v1"},
    "source_ordering": {"const": "role-source_id-ascending"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/availableJsonObject"},
          {"$ref": "#/$defs/availableDataset"},
          {"$ref": "#/$defs/unavailableSource"}
        ]
      }
    },
    "authority": {"const": false},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "version",
    "manifest_id",
    "market",
    "cutoff",
    "created_at",
    "object_path_scheme",
    "source_ordering",
    "sources",
    "authority",
    "semantic_sha256"
  ]
}
