{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myquant.v17.generation-catalog.v1",
  "title": "V17BitemporalGenerationCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasetManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_path": {
          "type": "string",
          "pattern": "^data/private/v17_sources/objects/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"
        },
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "myquant.v17.dataset-manifest.v1"}
      },
      "required": [
        "object_path",
        "byte_sha256",
        "size_bytes",
        "semantic_sha256",
        "schema_version"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {"$ref": "#/$defs/identifier"},
        "domain": {
          "enum": [
            "MARKET",
            "PIT_MEMBERSHIP",
            "FUNDAMENTAL",
            "BENCHMARK_TOTAL_RETURN",
            "CORPORATE_ACTION"
          ]
        },
        "dataset_manifest_ref": {"$ref": "#/$defs/datasetManifestRef"},
        "record_schema_id": {"$ref": "#/$defs/identifier"},
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "valid_time_field": {"$ref": "#/$defs/identifier"},
        "available_time_field": {"$ref": "#/$defs/identifier"},
        "revision_field": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "selection_policy": {
          "const": "available_at_or_before_cutoff_then_latest_valid_revision"
        },
        "conflict_policy": {"const": "conflict_is_invalid_no_fallback"}
      },
      "required": [
        "table_id",
        "domain",
        "dataset_manifest_ref",
        "record_schema_id",
        "primary_key",
        "valid_time_field",
        "available_time_field",
        "revision_field",
        "selection_policy",
        "conflict_policy"
      ]
    }
  },
  "properties": {
    "version": {"const": "myquant.v17.generation-catalog.v1"},
    "catalog_id": {"$ref": "#/$defs/identifier"},
    "generation_id": {"$ref": "#/$defs/identifier"},
    "catalog_kind": {
      "enum": [
        "MARKET",
        "PIT_MEMBERSHIP",
        "FUNDAMENTAL",
        "BENCHMARK_TOTAL_RETURN",
        "CORPORATE_ACTION",
        "COMPOSITE"
      ]
    },
    "storage_scope": {"const": "V17_PRIVATE"},
    "market": {"const": "CN"},
    "cutoff": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_manifest_byte_sha256": {"$ref": "#/$defs/sha256"},
    "table_ordering": {"const": "table_id-ascending"},
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/table"}
    },
    "authority": {"const": false},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "version",
    "catalog_id",
    "generation_id",
    "catalog_kind",
    "storage_scope",
    "market",
    "cutoff",
    "created_at",
    "source_manifest_byte_sha256",
    "table_ordering",
    "tables",
    "authority",
    "semantic_sha256"
  ]
}
