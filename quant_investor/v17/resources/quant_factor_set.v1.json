{
  "schema": "myquant-v17-quant-factor-set.v1",
  "authority": false,
  "implementation_source": "quant_investor/factors/price_volume.py",
  "implementation_source_sha256": "a2c7ec5f2ec30a5367662c86151f8da42e6d5b6b3d99069c106be9aaf28ca168",
  "scope": "sealed_top24_plus_holdings_only",
  "blend": "equal_weight_cross_sectional_percentile_rank",
  "direction": "higher_is_better",
  "factors": [
    {
      "name": "pv_blend_volstab19x2_mom90_amihud5_w80",
      "weight": 0.3333333333333333,
      "definition": "-CV(volume,19), smoothed for 2 sessions; 90-session momentum; 5-session mean Amihud; inner percentile rank is 60% momentum plus 40% Amihud and reranked; final value is 80% volume-stability percentile plus 20% inner percentile",
      "definition_sha256": "a412e07a6c5df48f250577d821209670ffce36794c61b514c8eb8b3b412a499d"
    },
    {
      "name": "pv_short_reversal_25d",
      "weight": 0.3333333333333333,
      "definition": "negative 25-session close return",
      "definition_sha256": "17863a088f0bebaaf68ea137f13ab3fb7576bb24514f6c87735838b9643467df"
    },
    {
      "name": "pv_downside_volatility_15d",
      "weight": 0.3333333333333333,
      "definition": "negative standard deviation of 15-session returns after replacing non-negative returns with zero",
      "definition_sha256": "8bb6170626d59c45aa2d21171e1660ad06fdc5efc322006869bac529e79b4152"
    }
  ],
  "calibration": {
    "lookback_open_days": 1260,
    "pit_mature_samples_only": true,
    "target": "horizon_excess_return_gt_zero",
    "deciles": 10,
    "probability": "(wins+0.5)/(n+1)",
    "monotonic_fit": "weighted_deterministic_pava_non_decreasing",
    "minimum_observations_per_decile": 200,
    "minimum_cross_section_dates_per_decile": 24,
    "horizons_open_days": [20, 60]
  },
  "states": {
    "BUY_NOW": "p20>=0.60 and p60>=0.60",
    "TRIM_TIMING": "p20<=0.40 and p60<=0.40",
    "WATCH": "otherwise",
    "UNREADY": "any factor or calibration requirement unavailable"
  }
}
