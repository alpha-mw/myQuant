{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme_taxonomy.v2",
  "type": "object",
  "required": ["schema_version", "taxonomy_id", "version", "nodes"],
  "properties": {
    "schema_version": {"const": "theme_taxonomy.v2"},
    "taxonomy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["theme_id", "name", "mandate", "tradable_node"],
        "properties": {
          "theme_id": {"type": "string", "pattern": "::"},
          "name": {"type": "string", "minLength": 1},
          "parent_id": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "mandate": {"enum": ["technology", "advanced_manufacturing", "tactical", "observation"]},
          "tradable_node": {"type": "boolean"},
          "supply_chain_roles": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
