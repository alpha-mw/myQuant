{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pevc_thesis.v1",
  "type": "object",
  "required": ["schema_version", "thesis_id", "theme_id", "version", "status", "tam", "technology_maturity", "bottlenecks", "moat_strength", "customer_validation", "commercialization_stage", "milestones", "kill_criteria", "horizon_months", "confidence", "review_by", "available_at"],
  "properties": {
    "schema_version": {"const": "pevc_thesis.v1"},
    "thesis_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "pattern": "::"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved", "superseded", "rejected"]},
    "tam": {"type": "string", "minLength": 1},
    "technology_maturity": {"type": "number", "minimum": 0, "maximum": 1},
    "bottlenecks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "moat_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "customer_validation": {"type": "number", "minimum": 0, "maximum": 1},
    "commercialization_stage": {"type": "number", "minimum": 0, "maximum": 1},
    "milestones": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "kill_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "valuation_ceiling": {"type": ["number", "null"], "minimum": 0},
    "horizon_months": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_by": {"type": "string", "format": "date"},
    "available_at": {"type": "string", "format": "date"},
    "prior_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source_type": {"type": "string"},
    "source_ref": {"type": "string"},
    "source_hash": {"type": "string"},
    "approved_at": {"type": "string"},
    "content_hash": {"type": "string"},
    "notes": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
