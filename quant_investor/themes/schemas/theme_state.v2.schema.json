{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme_state.v2",
  "type": "object",
  "required": ["schema_version", "theme_id", "as_of", "attention", "industrial_validation", "market_confirmation", "crowding", "valuation_risk", "evidence_confidence", "lifecycle", "lane"],
  "properties": {
    "schema_version": {"const": "theme_state.v2"},
    "theme_id": {"type": "string", "pattern": "::"},
    "theme_name": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "attention": {"type": "number", "minimum": 0, "maximum": 1},
    "industrial_validation": {"type": "number", "minimum": 0, "maximum": 1},
    "market_confirmation": {"type": "number", "minimum": 0, "maximum": 1},
    "crowding": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "valuation_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "attention_5d": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "attention_20d": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "attention_60d": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "attention_120d": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "attention_turnover_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "new_high_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "leader_persistence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "attention_history_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "lifecycle": {"enum": ["discovery", "warming", "validated_trend", "crowded", "cooling", "broken"]},
    "mandate": {"type": "string"},
    "tradable_node": {"type": "boolean"},
    "lane": {"enum": ["market_observation", "tech_thesis_watch", "formal_investable"]},
    "base_rank_score": {"type": "number", "minimum": 0, "maximum": 1},
    "member_count": {"type": "integer", "minimum": 0},
    "nav_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "base_percentile_rank": {"type": "number", "minimum": 0, "maximum": 1},
    "pevc_prior": {"type": "number", "minimum": 0, "maximum": 1},
    "pevc_rank_adjustment": {"type": "number", "minimum": -0.1, "maximum": 0.1},
    "adjusted_percentile_rank": {"type": "number", "minimum": 0, "maximum": 1},
    "eligibility_blockers": {"type": "array", "items": {"type": "string"}},
    "prequalification_blockers": {"type": "array", "items": {"type": "string"}},
    "downstream_blockers": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "pending_transition": {"type": "string"},
    "pending_confirmation_dates": {"type": "array", "items": {"type": "string", "format": "date"}},
    "latest_evidence_available_at": {"type": "string"},
    "latest_industrial_evidence_available_at": {"type": "string"},
    "thesis_id": {"type": "string"},
    "thesis_version": {"type": "string"}
  },
  "additionalProperties": false
}
