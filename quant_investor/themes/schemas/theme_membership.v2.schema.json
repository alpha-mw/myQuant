{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme_membership.v2",
  "type": "object",
  "required": ["schema_version", "theme_id", "symbol", "effective_from", "available_at", "confidence"],
  "properties": {
    "schema_version": {"const": "theme_membership.v2"},
    "membership_id": {"type": "string"},
    "theme_id": {"type": "string", "pattern": "::"},
    "theme_name": {"type": "string"},
    "theme_type": {"enum": ["concept", "technology", "industry"]},
    "symbol": {"type": "string", "minLength": 1},
    "symbol_name": {"type": "string"},
    "taxonomy_node_id": {"type": "string", "pattern": "::"},
    "supply_chain_role": {"type": "string"},
    "revenue_exposure": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": "string", "format": "date"},
    "available_at": {"type": "string", "format": "date"},
    "membership_status": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_type": {"type": "string"},
    "source_ref": {"type": "string"},
    "evidence_text": {"type": "string"},
    "maintainer": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
