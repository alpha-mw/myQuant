+            "publish_current_dashboard": False,
+        },
+    )
+    request = put(
+        "request.json",
+        {
+            "schema_version": "cn-daily-production-request.v1",
+            "market": "CN",
+            "strategy_id": "aggressive_tech_manufacturing",
+            "action": "EXECUTE",
