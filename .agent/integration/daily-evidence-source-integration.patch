+        if not _EARLIEST_CAPTURE_LOCAL <= provider_local <= _PROVIDER_CLOSE_LATEST_LOCAL:
+            raise IntelligenceError("Sina quote provider time is outside the trading-day range")
+    if observed_symbols != expected_symbols:
