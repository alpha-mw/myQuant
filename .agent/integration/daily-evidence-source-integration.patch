+def _signal_percentiles(rows: Mapping[str, Decimal]) -> dict[str, Decimal]:
+    ordered = sorted(rows, key=lambda symbol: (rows[symbol], symbol.encode("ascii")))
+    result: dict[str, Decimal] = {}
+    denominator = Decimal(max(len(ordered) - 1, 1))
