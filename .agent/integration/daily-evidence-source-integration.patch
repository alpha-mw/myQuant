+        tmp_path / market["path"]
+    ).read_bytes()
+    before = {
+        str(p): (p.read_bytes(), p.stat().st_mtime_ns) for p in tmp_path.rglob("*") if p.is_file()
+    }
+    assert producer.publish_maintenance_handoff(**args) == ref
+    assert before == {
