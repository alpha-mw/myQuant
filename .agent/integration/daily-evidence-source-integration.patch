+    def stop_auxiliary(ctx):
+        assert anchor.is_file(), "auxiliary reached before native handoff"
+        events.append("auxiliary_after_handoff")
+        raise AuxiliaryStop()
+
+    original_settle = DailyFactorLoop._settle
