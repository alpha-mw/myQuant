{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myquant.local/schema/dashboard_contract.v2.schema.json",
  "title": "myQuant Dashboard Contract v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "schema_sha256",
    "protocol_hash",
    "run_id",
    "generated_at",
    "status",
    "blockers",
    "as_of_matrix",
    "trading_calendar",
    "nav_return_provenance",
    "sources",
    "nav",
    "positions",
    "trades",
    "themes",
    "theme_protocol",
    "factors",
    "factor_protocol",
    "reconciliation",
    "metric_policy"
  ],
  "properties": {
    "schema_version": { "const": "dashboard_contract.v2" },
    "schema_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "protocol_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["fresh", "stale", "partial", "blocked", "sample"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "as_of_matrix": {
      "type": "object",
      "required": [
        "strategy_record_date",
        "strategy_record_at",
        "analysis_trading_date",
        "quote_at",
        "benchmark_value_dates",
        "theme_date",
        "factor_registry_sha"
      ],
      "properties": {
        "strategy_record_date": { "type": ["string", "null"] },
        "strategy_record_at": { "type": ["string", "null"] },
        "analysis_trading_date": { "type": ["string", "null"] },
        "quote_at": { "type": ["string", "null"] },
        "benchmark_value_dates": { "type": "object" },
        "theme_date": { "type": ["string", "null"] },
        "factor_registry_sha": { "type": ["string", "null"] }
      }
    },
    "trading_calendar": {
      "type": "object",
      "required": [
        "status",
        "source_system",
        "expected_open_dates",
        "expected_open_date_count",
        "mask_sha256"
      ],
      "properties": {
        "status": { "enum": ["available", "missing"] },
        "source_system": { "const": "strict_parquet.cn_bars.trade_date" },
        "path_summary": { "type": ["string", "null"] },
        "start_date": { "type": ["string", "null"] },
        "end_date": { "type": ["string", "null"] },
        "expected_open_dates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "expected_open_date_count": { "type": "integer", "minimum": 0 },
        "first_open_date": { "type": ["string", "null"] },
        "last_open_date": { "type": ["string", "null"] },
        "mask_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nav_return_provenance": {
      "type": "object",
      "required": [
        "source_field",
        "return_method",
        "gross_or_net",
        "trade_fee_inclusion",
        "secondary_fee_adjustment_allowed"
      ],
      "properties": {
        "source_field": { "type": "string" },
        "return_method": { "type": "string" },
        "gross_or_net": { "enum": ["gross", "net", "unknown"] },
        "trade_fee_inclusion": { "enum": ["included", "excluded", "unknown"] },
        "secondary_fee_adjustment_allowed": { "const": false }
      }
    },
    "sources": { "type": "object" },
    "nav": { "type": "array", "items": { "$ref": "#/$defs/nav" } },
    "positions": { "type": "array", "items": { "$ref": "#/$defs/position" } },
    "trades": { "type": "array", "items": { "$ref": "#/$defs/trade" } },
    "themes": { "type": "array", "items": { "type": "object" } },
    "theme_protocol": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_hash",
        "status",
        "blockers",
        "formal_enabled",
        "formal_kill_switch",
        "formal_pool",
        "formal_pool_count",
        "rollback_status",
        "readback_verified"
      ],
      "properties": {
        "schema_version": { "const": "theme_protocol.v2" },
        "protocol_hash": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "observer_enabled": { "type": ["boolean", "null"] },
        "formal_enabled": { "type": ["boolean", "null"] },
        "formal_kill_switch": { "type": ["boolean", "null"] },
        "formal_pool": { "type": "array", "items": { "type": "string" } },
        "formal_pool_count": { "type": "integer", "minimum": 0 },
        "formal_producer": { "type": ["string", "null"] },
        "rollback_status": { "type": ["string", "null"] },
        "rollback_reason": { "type": ["string", "null"] },
        "lane_counts": { "type": ["object", "null"] },
        "readback_verified": { "type": "boolean" },
        "artifact_sha256": { "type": ["string", "null"] }
      }
    },
    "factors": { "type": "array", "items": { "type": "object" } },
    "factor_protocol": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_version",
        "expected_protocol_hash",
        "protocol_hash",
        "status",
        "blockers",
        "readback_verified"
      ],
      "properties": {
        "schema_version": { "const": "factor-governance-protocol.v2" },
        "protocol_version": { "const": "v2" },
        "expected_protocol_hash": { "type": ["string", "null"] },
        "protocol_hash": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "readback_verified": { "type": "boolean" },
        "canonical_producer_available": { "type": "boolean" },
        "canonical_production_apply_eligible": { "type": "boolean" },
        "canonical_producer_blocker": { "type": ["string", "null"] }
      }
    },
    "reconciliation": {
      "type": "object",
      "required": [
        "tolerance",
        "daily",
        "valid_nav_return_days",
        "covered_days",
        "coverage_ratio",
        "reconciled_days",
        "status",
        "coverage_basis",
        "calendar_status",
        "blockers",
        "diagnostics"
      ],
      "properties": {
        "tolerance": { "type": "number", "minimum": 0 },
        "daily": { "type": "array", "items": { "type": "object" } },
        "valid_nav_return_days": { "type": "integer", "minimum": 0 },
        "covered_days": { "type": "integer", "minimum": 0 },
        "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "reconciled_days": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["reconciled", "partial"] },
        "coverage_basis": { "const": "strict_parquet_trade_date_mask" },
        "calendar_status": { "enum": ["available", "missing"] },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "object" }
      }
    },
    "metric_policy": {
      "type": "object",
      "required": [
        "returns_unit",
        "contribution_formula",
        "annualization_min_open_day_coverage",
        "annualization_min_valid_daily_returns",
        "rolling_window_min_open_day_coverage",
        "trading_calendar_required",
        "excess_curve",
        "monthly_return",
        "unknown_numeric"
      ]
    }
  },
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "nav": {
      "type": "object",
      "required": ["date", "portfolio_nav"],
      "properties": {
        "date": { "type": "string" },
        "portfolio_nav": { "$ref": "#/$defs/nullableNumber" },
        "portfolio_return": { "$ref": "#/$defs/nullableNumber" },
        "cash_weight": { "$ref": "#/$defs/nullableNumber" },
        "gross_exposure": { "$ref": "#/$defs/nullableNumber" },
        "net_exposure": { "$ref": "#/$defs/nullableNumber" }
      },
      "patternProperties": {
        "^.*_nav$": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "position": {
      "type": "object",
      "required": [
        "date",
        "ticker",
        "nav_weight",
        "equity_sleeve_weight",
        "daily_return",
        "contribution"
      ],
      "properties": {
        "date": { "type": "string" },
        "ticker": { "type": "string" },
        "nav_weight": { "$ref": "#/$defs/nullableNumber" },
        "equity_sleeve_weight": { "$ref": "#/$defs/nullableNumber" },
        "daily_return": { "$ref": "#/$defs/nullableNumber" },
        "contribution": { "$ref": "#/$defs/nullableNumber" },
        "contribution_effective_date": { "type": ["string", "null"] },
        "contribution_date_source": { "type": ["string", "null"] }
      }
    },
    "trade": {
      "type": "object",
      "required": ["trade_date", "ticker", "side", "price", "quantity", "fee"],
      "properties": {
        "trade_date": { "type": "string" },
        "ticker": { "type": "string" },
        "side": { "type": "string" },
        "price": { "$ref": "#/$defs/nullableNumber" },
        "quantity": { "$ref": "#/$defs/nullableNumber" },
        "fee": { "$ref": "#/$defs/nullableNumber" }
      }
    }
  }
}
