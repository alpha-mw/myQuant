{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myquant.local/schema/cn_aggressive_dashboard.v2.schema.json",
  "title": "CN aggressive daily holdings-continuity Dashboard envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_attempt_id",
    "generated_at",
    "generation_local_date",
    "canonical_v1",
    "canonical_v1_ref",
    "integrity",
    "continuity_authority",
    "freshness",
    "completeness",
    "research_mark",
    "source_refs",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cn_aggressive_dashboard.v2"},
    "publication_attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?\\+08:00$"
    },
    "generation_local_date": {"$ref": "#/$defs/date"},
    "canonical_v1": {"type": "object"},
    "canonical_v1_ref": {"$ref": "#/$defs/sourceRef"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"const": "VERIFIED"}}
    },
    "continuity_authority": {"$ref": "#/$defs/continuityAuthority"},
    "freshness": {"$ref": "#/$defs/freshness"},
    "completeness": {"$ref": "#/$defs/completeness"},
    "research_mark": {"$ref": "#/$defs/researchMark"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(?:SH|SZ|BJ)$"},
    "number": {"type": "number"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "continuityAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "anchor_record_id",
        "anchor_data_date",
        "anchor_financial_state_sha256",
        "active_ledger_sha256",
        "holdings_valid_through",
        "financial_state_changed",
        "receipt_id",
        "receipt_content_sha256"
      ],
      "properties": {
        "status": {"enum": ["NO_ACTION_BOUND", "FINANCIAL_STATE_PUBLICATION", "UNCONFIRMED"]},
        "anchor_record_id": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{4}$"},
        "anchor_data_date": {"$ref": "#/$defs/date"},
        "anchor_financial_state_sha256": {"$ref": "#/$defs/sha256"},
        "active_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "holdings_valid_through": {"$ref": "#/$defs/date"},
        "financial_state_changed": {"type": "boolean"},
        "receipt_id": {"type": ["string", "null"]},
        "receipt_content_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "NO_ACTION_BOUND"}}},
          "then": {
            "properties": {
              "financial_state_changed": {"const": false},
              "receipt_id": {"type": "string", "minLength": 1},
              "receipt_content_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "FINANCIAL_STATE_PUBLICATION"}}},
          "then": {
            "properties": {
              "financial_state_changed": {"const": true},
              "receipt_id": {"const": null},
              "receipt_content_sha256": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "UNCONFIRMED"}}},
          "then": {
            "properties": {
              "financial_state_changed": {"const": false},
              "receipt_id": {"const": null},
              "receipt_content_sha256": {"const": null}
            }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "mark_as_of", "generated_at", "valid_through", "source_kind", "reason"],
      "properties": {
        "status": {"enum": ["UPDATED", "STALE"]},
        "scope": {"const": "DAILY_SYNC_LATEST_VERIFIED_LOCAL_CLOSE"},
        "mark_as_of": {"$ref": "#/$defs/date"},
        "generated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?\\+08:00$"
        },
        "valid_through": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T23:59:59\\+08:00$"
        },
        "source_kind": {"const": "STRICT_CN_EOD_CLOSE"},
        "reason": {
          "enum": [
            "CURRENT_DAILY_RECEIPT_AND_LATEST_LOCAL_CLOSE",
            "CURRENT_FINANCIAL_PUBLICATION_AND_LATEST_LOCAL_CLOSE",
            "DAILY_CONTINUITY_RECEIPT_MISSING"
          ]
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_holdings", "current_absolute_performance", "canonical_history", "benchmark_relative", "benchmark_as_of", "legacy_caveats"],
      "properties": {
        "current_holdings": {"enum": ["COMPLETE", "STALE"]},
        "current_absolute_performance": {"enum": ["COMPLETE", "STALE"]},
        "canonical_history": {"enum": ["COMPLETE", "PARTIAL"]},
        "benchmark_relative": {"enum": ["COMPLETE", "AS_OF_PRIOR_DATE"]},
        "benchmark_as_of": {"$ref": "#/$defs/date"},
        "legacy_caveats": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "shares", "avg_cost", "cost_basis", "price", "price_date", "price_evidence_status", "market_value", "unrealized_pnl", "nav_weight", "equity_weight", "source_ref"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "name": {"type": "string", "minLength": 1},
        "shares": {"type": "number", "exclusiveMinimum": 0},
        "avg_cost": {"$ref": "#/$defs/number"},
        "cost_basis": {"$ref": "#/$defs/number"},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "price_date": {"$ref": "#/$defs/date"},
        "price_evidence_status": {"enum": ["EXACT_CLOSE", "BOUND_SUSPENSION_CARRY_FORWARD"]},
        "market_value": {"$ref": "#/$defs/number"},
        "unrealized_pnl": {"$ref": "#/$defs/number"},
        "nav_weight": {"$ref": "#/$defs/number"},
        "equity_weight": {"$ref": "#/$defs/number"},
        "source_ref": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "markedPortfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash", "market_value", "nav", "unrealized_pnl", "cash_weight", "gross_exposure"],
      "properties": {
        "cash": {"$ref": "#/$defs/number"},
        "market_value": {"$ref": "#/$defs/number"},
        "nav": {"$ref": "#/$defs/number"},
        "unrealized_pnl": {"$ref": "#/$defs/number"},
        "cash_weight": {"$ref": "#/$defs/number"},
        "gross_exposure": {"$ref": "#/$defs/number"}
      }
    },
    "currentAbsolutePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_date", "anchor_date", "marked_nav", "initial_capital", "cumulative_return", "continuity_interval_return", "max_drawdown", "evidence_status", "authority"],
      "properties": {
        "point_date": {"$ref": "#/$defs/date"},
        "anchor_date": {"$ref": "#/$defs/date"},
        "marked_nav": {"$ref": "#/$defs/number"},
        "initial_capital": {"const": 1000000},
        "cumulative_return": {"$ref": "#/$defs/number"},
        "continuity_interval_return": {"$ref": "#/$defs/number"},
        "max_drawdown": {"$ref": "#/$defs/number"},
        "evidence_status": {"const": "HASH_BOUND_CONTINUITY_MARK"},
        "authority": {"const": "VIEW_ONLY_NO_STORE_OR_PERFORMANCE_AUTHORITY"}
      }
    },
    "researchMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "source_kind", "mark_date", "anchor_record_id", "base_ledger_sha256", "base_financial_state_sha256", "positions", "portfolio", "current_absolute_performance", "canonical_effect", "ledger_effect", "performance_effect", "paper_effect", "trade_effect"],
      "properties": {
        "status": {"const": "AVAILABLE"},
        "authority": {"const": "VIEW_ONLY_NO_STORE_OR_PERFORMANCE_AUTHORITY"},
        "source_kind": {"const": "STRICT_CN_EOD_CLOSE"},
        "mark_date": {"$ref": "#/$defs/date"},
        "anchor_record_id": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{4}$"},
        "base_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "base_financial_state_sha256": {"$ref": "#/$defs/sha256"},
        "positions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/position"}},
        "portfolio": {"$ref": "#/$defs/markedPortfolio"},
        "current_absolute_performance": {"$ref": "#/$defs/currentAbsolutePerformance"},
        "canonical_effect": {"const": "NONE"},
        "ledger_effect": {"const": "NONE"},
        "performance_effect": {"const": "NONE"},
        "paper_effect": {"const": "NONE"},
        "trade_effect": {"const": "NONE"}
      }
    }
  }
}
