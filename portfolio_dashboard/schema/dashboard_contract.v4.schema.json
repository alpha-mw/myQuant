{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myquant.local/schema/dashboard_contract.v4.schema.json",
  "title": "myQuant V17 v4 Canary Dashboard Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_sha256",
    "protocol_version",
    "view_label",
    "read_only",
    "is_default",
    "status",
    "strategy_id",
    "cutoff",
    "run_id",
    "authority",
    "formal_active_pointer_ref",
    "formal_activation_receipt_ref",
    "v15_run_readiness",
    "v17_v4_run_readiness",
    "gross_weight",
    "cash_weight",
    "positions"
  ],
  "properties": {
    "schema_version": {"const": "dashboard_contract.v4"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_version": {"const": "myquant.v17.v4"},
    "view_label": {"const": "CANARY"},
    "read_only": {"const": true},
    "is_default": {"const": false},
    "status": {"const": "canary"},
    "strategy_id": {"$ref": "#/$defs/identifier"},
    "cutoff": {"type": "string", "format": "date-time"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "authority": {"$ref": "#/$defs/authority"},
    "formal_active_pointer_ref": {"$ref": "#/$defs/artifactRef"},
    "formal_activation_receipt_ref": {"$ref": "#/$defs/artifactRef"},
    "v15_run_readiness": {
      "description": "Reserved for the unchanged Dashboard Contract v3 field; v4 never relabels it.",
      "type": "null"
    },
    "v17_v4_run_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "formal_active_pointer_ref",
        "formal_activation_receipt_ref"
      ],
      "properties": {
        "state": {"const": "FORMAL_ACTIVE"},
        "formal_active_pointer_ref": {"$ref": "#/$defs/artifactRef"},
        "formal_activation_receipt_ref": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "gross_weight": {"$ref": "#/$defs/nonnegativeDecimal"},
    "cash_weight": {"$ref": "#/$defs/nonnegativeDecimal"},
    "positions": {
      "type": "array",
      "maxItems": 524,
      "items": {"$ref": "#/$defs/position"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonnegativeDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "execution",
        "formal_research_publication",
        "order",
        "research_runtime_default",
        "trade"
      ],
      "properties": {
        "broker": {"const": false},
        "execution": {"const": false},
        "formal_research_publication": {"const": true},
        "order": {"const": false},
        "research_runtime_default": {"const": false},
        "trade": {"const": false}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "relative_path",
        "byte_sha256",
        "semantic_sha256",
        "strategy_id",
        "cutoff"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_version": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "byte_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "strategy_id": {"$ref": "#/$defs/identifier"},
        "cutoff": {"type": "string", "format": "date-time"}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "lane",
        "current_target",
        "final_target"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(?:SH|SZ|BJ)$"
        },
        "lane": {
          "enum": ["REVIEW_ONLY_HOLDING", "SELECTION_POOL"]
        },
        "current_target": {"$ref": "#/$defs/nonnegativeDecimal"},
        "final_target": {"$ref": "#/$defs/nonnegativeDecimal"}
      }
    }
  }
}
