{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myquant.local/schema/dashboard_contract.v16.evidence-v2.schema.json",
  "title": "myQuant Dashboard Contract v16 Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_version",
    "protocol_attempt_id",
    "run_id",
    "generated_at",
    "analysis_trade_date",
    "source_refs",
    "formal_branches",
    "retrieval_role",
    "risk_advisor_role",
    "menu",
    "cash_ratio",
    "positive_weight_count",
    "target_plus_cash",
    "readiness",
    "projection_validation_complete",
    "authority_source_complete",
    "blockers",
    "blocker_sources",
    "semantic_sha256"
  ],
  "properties": {
    "schema_version": { "const": "dashboard_contract.v16.evidence-v2" },
    "architecture_version": { "const": "16.0.0" },
    "protocol_attempt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "generated_at": { "type": "string", "minLength": 1 },
    "analysis_trade_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_plan", "readiness_v4", "candidate_report"],
      "properties": {
        "publication_plan": { "$ref": "#/$defs/evidenceRef" },
        "readiness_v4": { "$ref": "#/$defs/evidenceRef" },
        "candidate_report": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "formal_branches": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/formalBranch" }
    },
    "retrieval_role": { "const": "evidence_only_no_scoring_or_weight" },
    "risk_advisor_role": { "const": "advisory_only" },
    "menu": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/menuItem" }
    },
    "cash_ratio": { "$ref": "#/$defs/f64" },
    "positive_weight_count": { "type": "integer", "minimum": 0, "maximum": 12 },
    "target_plus_cash": { "$ref": "#/$defs/f64" },
    "readiness": { "$ref": "#/$defs/readiness" },
    "projection_validation_complete": { "const": true },
    "authority_source_complete": { "const": false },
    "blockers": { "$ref": "#/$defs/stringSet" },
    "blocker_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/blockerSource" }
    },
    "semantic_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "f64": {
      "type": "string",
      "pattern": "^f64:(?:0x0\\.0p\\+0|-?0x(?:1\\.[0-9a-f]{13}|0\\.(?!0{13})[0-9a-f]{13})p[+-][0-9]+)$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_schema",
        "absolute_path",
        "byte_sha256",
        "semantic_sha256",
        "root_policy"
      ],
      "properties": {
        "schema_version": { "const": "v16.evidence-ref.v2" },
        "artifact_schema": { "type": "string", "minLength": 1 },
        "absolute_path": { "type": "string", "pattern": "^/[^\\u0000]+[^/]$" },
        "byte_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_sha256": { "$ref": "#/$defs/sha256" },
        "root_policy": { "const": "v16.private-evidence-root.v2" }
      }
    },
    "formalBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "weight"],
      "properties": {
        "branch": { "enum": ["quant", "fundamental", "macro", "llm"] },
        "weight": { "const": "0.25" }
      }
    },
    "posterior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "win_rate",
        "expected_alpha",
        "edge_after_costs",
        "win_rate_interval_90",
        "expected_alpha_interval_90",
        "cost_input_ref"
      ],
      "properties": {
        "win_rate": { "$ref": "#/$defs/f64" },
        "expected_alpha": { "$ref": "#/$defs/f64" },
        "edge_after_costs": { "$ref": "#/$defs/f64" },
        "win_rate_interval_90": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/f64" }
        },
        "expected_alpha_interval_90": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/f64" }
        },
        "cost_input_ref": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "branchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "raw_score",
        "confidence",
        "calibrated_probability",
        "evidence_ids",
        "source_ref",
        "model_bundle_ref"
      ],
      "properties": {
        "branch": { "enum": ["quant", "fundamental", "macro", "llm"] },
        "raw_score": { "$ref": "#/$defs/f64" },
        "confidence": { "$ref": "#/$defs/f64" },
        "calibrated_probability": { "$ref": "#/$defs/f64" },
        "evidence_ids": { "$ref": "#/$defs/stringSet" },
        "source_ref": { "$ref": "#/$defs/evidenceRef" },
        "model_bundle_ref": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "retrievalAdvisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "supporting_fact_ids",
        "contradicting_fact_ids",
        "conflict_note"
      ],
      "properties": {
        "branch": { "enum": ["quant", "fundamental", "macro"] },
        "supporting_fact_ids": { "$ref": "#/$defs/stringSet" },
        "contradicting_fact_ids": { "$ref": "#/$defs/stringSet" },
        "conflict_note": { "type": ["string", "null"] }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "selected_for_portfolio",
        "existing_weight",
        "target_weight",
        "rationale_sha256",
        "severe_risk_count",
        "risk_acceptance_rationale_sha256"
      ],
      "properties": {
        "action": { "enum": ["BUY", "HOLD", "AVOID", "SELL"] },
        "selected_for_portfolio": { "type": "boolean" },
        "existing_weight": { "$ref": "#/$defs/f64" },
        "target_weight": { "$ref": "#/$defs/f64" },
        "rationale_sha256": { "$ref": "#/$defs/sha256" },
        "severe_risk_count": { "type": "integer", "minimum": 0 },
        "risk_acceptance_rationale_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "posterior",
        "branch_evidence",
        "retrieval_advisory",
        "allocation"
      ],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9._-]{1,32}$" },
        "posterior": { "$ref": "#/$defs/posterior" },
        "branch_evidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/branchEvidence" }
        },
        "retrieval_advisory": {
          "type": "array",
          "items": { "$ref": "#/$defs/retrievalAdvisory" }
        },
        "allocation": { "$ref": "#/$defs/allocation" }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "activation_candidate",
        "new_risk_authorized",
        "production_apply_enabled",
        "production_pointer_switch_authorized",
        "codex_activation_authorized",
        "dashboard_activation_authorized",
        "sealed_live_human_receipt_verified",
        "broker_side_effects",
        "source_readiness_status"
      ],
      "properties": {
        "status": { "const": "no_new_risk" },
        "activation_candidate": { "const": false },
        "new_risk_authorized": { "const": false },
        "production_apply_enabled": { "const": false },
        "production_pointer_switch_authorized": { "const": false },
        "codex_activation_authorized": { "const": false },
        "dashboard_activation_authorized": { "const": false },
        "sealed_live_human_receipt_verified": { "const": false },
        "broker_side_effects": { "const": false },
        "source_readiness_status": { "const": "no_new_risk" }
      }
    },
    "blockerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "source"],
      "properties": {
        "blocker": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
