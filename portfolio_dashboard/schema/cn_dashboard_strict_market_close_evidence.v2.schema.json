{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cn_dashboard_strict_market_close_evidence.v2",
  "title": "CN Dashboard strict local market close evidence (canonical table bound)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "trade_date",
    "market_pointer_path",
    "market_pointer_sha256",
    "snapshot_manifest_path",
    "snapshot_manifest_sha256",
    "snapshot_id",
    "latest_complete_trade_date",
    "benchmark_input_path",
    "benchmark_input_sha256",
    "stocks",
    "table_partition_ref",
    "indices"
  ],
  "properties": {
    "schema_version": {"const": "cn_dashboard_strict_market_close_evidence.v2"},
    "market": {"const": "CN"},
    "trade_date": {"$ref": "#/$defs/compactDate"},
    "market_pointer_path": {"$ref": "#/$defs/projectPath"},
    "market_pointer_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_manifest_path": {"$ref": "#/$defs/projectPath"},
    "snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "latest_complete_trade_date": {"$ref": "#/$defs/compactDate"},
    "benchmark_input_path": {"$ref": "#/$defs/projectPath"},
    "benchmark_input_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_pointer_path": {"$ref": "#/$defs/projectPath"},
    "benchmark_pointer_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_generation_id": {"type": "string", "minLength": 1},
    "benchmark_manifest_path": {"type": "string", "minLength": 1},
    "benchmark_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_series_path": {"type": "string", "minLength": 1},
    "benchmark_series_sha256": {"$ref": "#/$defs/sha256"},
    "stocks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/stockRow"}
    },
    "table_partition_ref": {"$ref": "#/$defs/tablePartitionRef"},
    "indices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/indexRow"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compactDate": {"type": "string", "pattern": "^[0-9]{8}$"},
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(?:SH|SZ|BJ)$"},
    "close": {"type": "number", "exclusiveMinimum": 0},
    "stockRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "trade_date", "close"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "trade_date": {"$ref": "#/$defs/compactDate"},
        "close": {"$ref": "#/$defs/close"}
      }
    },
    "tablePartitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/projectPath",
          "pattern": "/_snapshots/[^/]+/table/bars/(?:year=[0-9]{4}/month=[0-9]{2}/)?part\\.parquet$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "indexRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ts_code",
        "trade_date",
        "close",
        "benchmark_input_path",
        "benchmark_input_sha256"
      ],
      "properties": {
        "ts_code": {"$ref": "#/$defs/symbol"},
        "trade_date": {"$ref": "#/$defs/compactDate"},
        "close": {"$ref": "#/$defs/close"},
        "benchmark_input_path": {"$ref": "#/$defs/projectPath"},
        "benchmark_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
